{
  "name": "langdrift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "langdrift": "./src/cli.ts"
  },
  "scripts": {
    "langdrift": "node ./src/cli.ts",
    "test": "node --test tests/*.test.ts",

    "agent": "node ./examples/agent/server.ts",

    "benchmark": "node ./examples/benchmark/run.ts",
    "benchmark:support": "DOMAIN=support SCENARIO=./examples/scenarios/support-routing.yaml node ./examples/benchmark/run.ts",
    "benchmark:ecommerce": "DOMAIN=ecommerce SCENARIO=./examples/scenarios/ecommerce-cancel-order.yaml node ./examples/benchmark/run.ts",
    "benchmark:scheduling": "DOMAIN=scheduling SCENARIO=./examples/scenarios/scheduling-reschedule.yaml node ./examples/benchmark/run.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
